{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "engines": {
    "node": ">=20.18 <21"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0 -p 5173",
    "build": "node scripts/clean-next.mjs && next build --webpack",
    "quality-gate": "npm run lint && npm run test:production-env && npm run test:standalone && npm run test:repo-config && npm run test:security-headers && npm run test:type-scale && npm run test:i18n-helpers && npm run test:coverage-contract && npm run test && npm run build",
    "quality-gate:installer": "npm run test:installer && npm run test:e2e:installer",
    "quality-gate:installer:strict": "npm run test:installer && npm run test:e2e:installer:strict",
    "quality-gate:installer:local": "node scripts/installer-quality-gate-local.mjs",
    "check:e2e:installer-env": "node scripts/installer-quality-gate-local.mjs --check",
    "check:e2e:installer-auth": "node scripts/installer-quality-gate-local.mjs --check-auth",
    "check:env:production": "node scripts/validate-production-env.mjs",
    "test:production-env": "node --test scripts/validate-production-env.test.mjs",
    "test:standalone": "node --test scripts/standalone-runtime.test.mjs",
    "test:repo-config": "node --test scripts/repo-config.test.mjs",
    "test:security-headers": "node --test scripts/security-headers.test.mjs",
    "test:type-scale": "node --test scripts/type-scale-ratchet.test.mjs",
    "test:i18n-helpers": "node --test scripts/local-copy-helper.test.mjs",
    "test:coverage-contract": "node scripts/validate-test-discovery.mjs",
    "start": "next start -H 0.0.0.0 -p 5173",
    "lint": "eslint .",
    "audit:high": "npm audit --audit-level=high",
    "test": "node scripts/run-vitest-gate.mjs",
    "test:installer": "set NODE_NO_WARNINGS=1&& vitest run --silent=passed-only src/lib/admin-access.test.ts src/test/RequireAuth.test.tsx src/test/InstallerWorkspacePage.test.tsx src/test/InstallerProjectPage.test.tsx src/test/InstallerSchedulePage.test.tsx src/test/InstallerIssuesPage.test.tsx src/test/InstallerEarningsPage.test.tsx src/test/InstallerSyncQueuePage.test.tsx src/test/InstallerScheduleExportButton.test.tsx src/test/ScheduleExport.test.ts",
    "test:coverage": "set NODE_NO_WARNINGS=1&& vitest run --coverage --silent=passed-only",
    "test:watch": "set NODE_NO_WARNINGS=1&& vitest --silent=passed-only",
    "test:e2e": "npm run build && node ./node_modules/@playwright/test/cli.js test",
    "test:e2e:installer": "npm run build && node ./node_modules/@playwright/test/cli.js test e2e/installer.spec.ts",
    "test:e2e:installer:strict": "node scripts/installer-e2e-strict.mjs",
    "test:e2e:installer:strict:local": "node scripts/installer-e2e-strict.mjs --env-path .env.e2e.local",
    "test:e2e:headed": "npm run build && node ./node_modules/@playwright/test/cli.js test --headed",
    "test:e2e:smoke": "npm run build && node ./node_modules/@playwright/test/cli.js test e2e/smoke.spec.ts",
    "test:e2e:smoke:local": "node scripts/admin-e2e-smoke.mjs --env-path .env.e2e.local",
    "test:e2e:release": "node scripts/visual-brand-smoke.mjs --scope all",
    "test:e2e:visual-brand": "node scripts/visual-brand-smoke.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@swc/helpers": "^0.5.21",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "next": "^16.2.11",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.21",
    "browserslist": "^4.28.8",
    "caniuse-lite": "^1.0.30001792",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "glob": {
      ".": "^13.0.6"
    },
    "next": {
      "sharp": "^0.35.3"
    },
    "postcss": "8.5.25",
    "postcss-selector-parser": "6.1.3"
  }
}
