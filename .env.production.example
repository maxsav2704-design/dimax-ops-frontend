# Copy to .env.production.local and replace with the real production API URL.
# Must be HTTPS and must not point to localhost.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Optional compatibility alias for legacy Vite code paths.
# If set, it must match NEXT_PUBLIC_API_BASE_URL exactly.
# VITE_API_BASE_URL=https://api.example.com
