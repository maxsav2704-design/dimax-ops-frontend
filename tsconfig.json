{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev/dev/types/**/*.ts",
    ".next-acceptance/types/**/*.ts",
    ".next-acceptance/dev/types/**/*.ts",
    ".next-acceptance/ui-20260911/types/**/*.ts",
    ".next-acceptance/ui-20260911/dev/types/**/*.ts",
    ".next-acceptance/live-window-20260911/types/**/*.ts",
    ".next-acceptance/live-window-20260911/dev/types/**/*.ts",
    ".next-acceptance/payroll-20260911/types/**/*.ts",
    ".next-acceptance/payroll-20260911/dev/types/**/*.ts",
    ".next-acceptance-preview/types/**/*.ts",
    ".next-acceptance-preview/dev/types/**/*.ts",
    ".next-ai-core/types/**/*.ts",
    ".next-ai-core/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-dev"
  ]
}
