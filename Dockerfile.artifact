ARG NODE_IMAGE=node:22-alpine

FROM ${NODE_IMAGE} AS runner
WORKDIR /app
ARG NEXT_PUBLIC_API_BASE_URL
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV HOSTNAME=0.0.0.0
ENV PORT=5173

RUN addgroup --gid 10001 dimax \
    && adduser --uid 10001 --ingroup dimax --disabled-password \
        --no-create-home --home /app dimax

COPY --chown=10001:10001 .next/standalone ./
COPY --chown=10001:10001 .next/static ./.next/static
COPY --chown=10001:10001 public ./public

USER 10001:10001
EXPOSE 5173
CMD ["node", "server.js"]

